# 1 = deterministic fake LLM, no network or keys needed. 0 = call the Anthropic API.
MOCK_MODE=1
# Required only when MOCK_MODE=0.
ANTHROPIC_API_KEY=
# Postgres DSN for the spend ledger. Unset = in-memory ledger (resets on restart). docker compose sets this for you.
DATABASE_URL=
# Monthly budget ceiling in USD (overrides config.yaml).
MONTHLY_BUDGET_USD=50
# Optional: a Slack-compatible webhook that receives budget alerts as {"text": "..."}.
ALERT_WEBHOOK_URL=
# Host port for the API under docker compose.
API_PORT=8101
# Optional: path to an alternative config.yaml (model IDs, prices, thresholds).
ROUTER_CONFIG=
